{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faeries Launcher",
  "version": "0.7.2",
  "identifier": "dev.faerie.launcher",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Faeries Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Faeries SMP",
    "shortDescription": "The Minecraft launcher for the Faeries SMP.",
    "longDescription": "Signs you in, sets up Minecraft 26.2 with Fabric, the Fabulously Optimized mod set, the Faeries mods and the server pack, and puts faeriessmp.com on your server list.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}